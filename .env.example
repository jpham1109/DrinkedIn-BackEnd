# Copy to .env for local development. For Render, set these as service
# environment variables in the dashboard (or via render.yaml for the
# non-secret ones) — Render containers don't read a .env file.
#
# Vars for removed legacy integrations (Instagram/RapidAPI, Google Maps,
# Spotify, Meilisearch) are intentionally not listed here — none of that
# code is live. Meilisearch stays explicitly parked; don't configure it
# for this deployment.

# --- Database ---
# Local dev only (docker-compose.yml's db service reads these directly).
# Render: not used — config/database.yml's production block reads
# DATABASE_URL instead, which Render injects automatically when the
# Postgres database (kinpour-db) is linked to this service (see
# render.yaml).
POSTGRES_HOST=db
POSTGRES_DB=DrinkedIn_BackEnd_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Rails secrets ---
# Decrypts credentials. Local dev uses config/master.key (gitignored,
# already present in your checkout) — this only needs setting here if
# master.key is unavailable. Render: set as a secret env var
# (sync: false in render.yaml), NOT committed. Approved decision: fresh
# production secrets, not the existing development master key — see
# ai/deployment-plan.md's "Production credentials" section for the
# per-environment credentials mechanism and why generating this is a
# separate, supervised step, not done as part of routine config.
RAILS_MASTER_KEY=

# --- URLs ---
# This service's own externally-reachable URL, host only (no scheme) —
# used by Rails.application.routes.default_url_options for generating
# cocktail/avatar image URLs and category popular_drinks image URLs.
# Local dev default (development.rb) is localhost:3010 if unset.
# Render: required, no fallback — the Render service's own URL (e.g.
# kinpour-api.onrender.com), or api.kinpour.com once that custom domain
# is live.
HOST_URL=localhost:3010

# The frontend's origin — used by config/initializers/cors.rb to allow
# cross-origin requests with credentials. Local dev: the CRA dev server's
# origin. Render: the frontend Static Site's exact URL (e.g.
# kinpour-web.onrender.com), or https://kinpour.com once live (no
# trailing slash).
CLIENT_URL=http://localhost:3030

# --- Object storage (Active Storage, production only) ---
# config/storage.yml's `amazon` service — used whenever
# config.active_storage.service = :amazon (production.rb only; local dev
# uses the :local disk service, no credentials needed). Decided: AWS S3,
# existing bucket in us-east-2 (Ohio) — same region as the Render
# resources. The code itself stays provider-agnostic (works with any
# S3-compatible endpoint via `endpoint:`/`force_path_style:` additions to
# storage.yml), that's just not what's actually deployed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET=
